# Dashboard (Next.js) environment. Copy to `.env` and never commit it.

# Where the Konverse backend API lives. The dashboard talks to it only from
# the server (Route Handlers), so this is never exposed to the browser.
BACKEND_URL=http://localhost:8000

# Secret used to sign the dashboard session cookie (HS256 via jose).
# Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string
