# ---------------------------------------------------------------------------
# Konverse environment variables — COMMIT ME. Copy to `.env`, fill in values,
# and NEVER commit `.env`.
#
# This template documents BOTH profiles:
#   * Production / integrated (needs Postgres, Qdrant, Redis, provider keys).
#   * Docker-free local (comments marked "local:" — the KONVERSE-LOCAL block at
#     the bottom is the full no-container, no-key profile).
#
# To run the fully local stack: copy this to `.env`, uncomment the local
# provider block, then `python -m scripts.init_db` + `uvicorn app.main:app`.
# ---------------------------------------------------------------------------

# --- App ---
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Platform admin (admin console) ---
# Operator key for /api/admin/* (sent as X-Admin-Key). Empty = admin disabled.
ADMIN_API_KEY=change-me-admin-key

# --- Relational store (SQLAlchemy async URL) ---
# Production:    postgresql+asyncpg://konverse:konverse@localhost:5432/konverse
# Local (NoSQL equivalent): sqlite+aiosqlite:///./konverse.db
DATABASE_URL=postgresql+asyncpg://konverse:konverse@localhost:5432/konverse

# --- Redis (cache + Celery broker + rate limiting) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Local: when true, Celery tasks run in-process (no broker/worker required).
CELERY_TASK_ALWAYS_EAGER=false

# --- Qdrant (vector store) ---
# Production:       http://localhost:6333
# Local (on-disk):  ./qdrant_local        (or :memory: for in-process/volatile)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=konverse_chunks

# --- Embeddings (backend pluggable) ---
# Backend:
#   "tei"    (default) OpenAI-compatible TEI/HF endpoint serving an open-source
#            model (default BAAI/bge-base-en-v1.5, 768-d).
#   "openai" OpenAI /v1/embeddings fallback.
#   "local"  on-device ONNX via fastembed — NO key, NO server. First use
#            downloads a small model (default BAAI/bge-small-en-v1.5, 384-d).
# EMBEDDING_SIZE must equal the model's output dimension; changing it after a
# Qdrant collection exists needs a new QDRANT_COLLECTION name + re-ingest.
EMBEDDING_BACKEND=tei
TEI_URL=http://localhost:8080
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_SIZE=768

# --- LLM / retrieval ---
# "anthropic" (default) streams Claude (needs ANTHROPIC_API_KEY).
# "local"     grounds the answer extractively on the top retrieved chunk — no
#             key, deterministic, verbatim citation.
LLM_BACKEND=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval: top-k chunks and the cosine minimum to attempt an answer. Below
# the threshold the API emits the canned "no information" fallback. The local
# 384-d embedder self-scores lower, so the local profile relaxes this to 0.5.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.60
LLM_MAX_TOKENS=1024

# --- Storage (document uploads) ---
STORAGE_DIR=./storage

# --- Rate limiting / guardrails / CORS ---
RATE_LIMITS_CSV=free=10/60,pro=120/60,enterprise=1000/60
RATE_LIMIT_FAIL_OPEN=true
GUARDRAIL_CLASSIFIER_MODEL=claude-sonnet-4-6
GUARDRAIL_CLASSIFIER_MAX_TOKENS=24
CORS_ORIGINS=*

# ============================================================================
# DOCKER-FREE LOCAL PROFILE
# Uncomment the block below to run the whole stack on-device with no containers
# and no provider API keys. Every external service is swapped for a local one.
# ============================================================================
# DATABASE_URL=sqlite+aiosqlite:///./konverse.db
# QDRANT_URL=./qdrant_local
# CELERY_TASK_ALWAYS_EAGER=true
# EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_SIZE=384
# LLM_BACKEND=local
# RETRIEVAL_MIN_SCORE=0.5