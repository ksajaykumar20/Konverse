# ---------------------------------------------------------------------------
# Konverse environment variables.
# Copy this file to `.env`, fill in real values, and NEVER commit `.env`.
# docker-compose.yml overrides the *host* of each infra service automatically
# so containers reach each other by service name — no need to change those
# here unless running the backend natively (uvicorn/celery on the host).
# ---------------------------------------------------------------------------

# --- App ---
# Production should set this to "production" and use HTTPS in front of the API.
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- PostgreSQL (SQLAlchemy async URL) --------------------------------------
# Native/local: postgresql+asyncpg://konverse:konverse@localhost:5432/konverse
DATABASE_URL=postgresql+asyncpg://konverse:konverse@localhost:5432/konverse

# --- Redis (cache + Celery broker + rate limiting) --------------------------
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector store) ---------------------------------------------------
QDRANT_URL=http://localhost:6333
# Collection for tenant-tagged embeddings. Created lazily on first use.
QDRANT_COLLECTION=konverse_chunks

# --- Celery -----------------------------------------------------------------
# Same Redis, different DB index: 0 = cache/rate-limit, 1 = celery.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Providers (unused until Phase 3 / Phase 4) ------------------------------
# Filled in later phases. Kept here so the shape is stable from the start.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Qdrant vector sizing (Phase 3) ------------------------------------------
# Embedding dimension for OpenAI text-embedding-3-small = 1536.
EMBEDDING_SIZE=1536